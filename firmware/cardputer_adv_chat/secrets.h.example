// secrets.h.example — copy this to secrets.h and fill in your values.
// secrets.h is gitignored so credentials never land in the repo.
//
// These only PRE-FILL the on-device setup portal ("EOS-Cardputer") — actual
// provisioning happens on the device itself and is saved to NVS, so secrets.h
// is optional. Wi-Fi SSID/password are entered directly in the WiFiManager
// portal, not here (unlike some other sketches, there's no SECRET_WIFI_* pair
// needed for this one).
#pragma once
#define SECRET_DAEMON_BASE "http://192.168.1.50:9000"   // LAN test; "https://<magic-dns>" for tailnet
#define SECRET_AUTH_TOKEN  "your-emptyos-auth-token"     // emptyos.toml [network] auth_token
#define SECRET_ROOM_ID     "cardputer"                   // the rooms agent_id this device talks to
