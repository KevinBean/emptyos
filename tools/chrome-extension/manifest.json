{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "EmptyOS",
  "version": "0.12.0",
  "description": "Thin bridge to EmptyOS for Browser Sessions, Aura chat, capture, lecture recording, reading, dictionary, jobs, voice, cards, and streaming.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "sidePanel",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:9000/*",
    "http://127.0.0.1:9000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open EmptyOS panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open EmptyOS side panel"
    },
    "start-lecture-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Start lecture capture on this tab"
    },
    "capture-lecture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Capture this page (screenshot + text) to the lecture note"
    }
  }
}
