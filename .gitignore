emptyos.toml
emptyos.toml.*bak
!demo/emptyos.toml
.claude/vault-connection.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Runtime telemetry (SQLite/JSON state). NOTE: this bare pattern matches ANY
# dir named data/ at ANY depth — engine/app reference datasets must be
# re-included below or they silently vanish from clones (bit thermal, soil,
# overhead_line). engines/personal/ stays ignored (excluded parent wins).
data/
!engines/*/data/
services/voice-api/models/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
.DS_Store
.obsidian/

# Local binaries / outputs that should never enter the public source repo
caddy.exe
results/

# Local AI-tool session history (aider CLI)
.aider*

# Scratch / experimental apps (not for public)
apps/test-app/
apps/extension/others/test-app/
.playwright-mcp/
*.wav

# Dogfood-agent throwaway vault + config (personal, never ships).
# The .example template IS committed so public users can bootstrap a
# parallel daemon on :9001 from a fresh clone. `dogfood/*` (not `dogfood/`)
# is required so the negation below can re-include a single file — git
# won't descend into a directory wholly ignored by the directory form.
dogfood/*
!dogfood/emptyos.toml.example

# Sandbox-pool member directories — auto-generated per pool member at
# spawn time. Each holds an auto-rendered emptyos.toml + isolated data/
# + throwaway vault/. Per-machine runtime state, never committed.
# Anchor with leading `/` so this matches the project root only — apps/
# can still have a legitimate `sandbox/` directory.
/sandbox-*/
# Legacy single-sandbox config dir (pre-pool); also runtime state.
/sandbox/

# Portfolio instance — Kevin-specific public-PROFESSIONAL content (name, real
# projects). Lives local + on the VPS only, deployed out-of-band (rsync). Never
# committed: it contains the user's name so check-personal would flag it, and
# it must never reach the public snapshot. portfolio/emptyos.toml is also a
# machine config. Run merged with the public demo compose (see
# portfolio/docker-compose.portfolio.yml).
/portfolio/

# Demo/portfolio env files — hold auth tokens + the funded OPENAI_API_KEY.
.env.demo
.env

# Personal apps & engines (not shipped with core OS)
apps/personal/
engines/personal/
tests/personal/

# Marketplace-installed apps are kept out of git per-clone via .git/info/exclude
# (the Store writes apps/<category>/<id>/ lines there on install) — not here,
# so the tracked .gitignore stays free of per-machine install churn.

# Personal skills (contain PII — names, paths, career data)
skills/life-strategic-advisor/
skills/life-job-evaluator/
skills/creative-mv-generator/
skills/dev-claude-md-optimizer/
skills/tool-icon-creator/
# Skill runtime artifacts
skills/**/.env
skills/**/cache.json
skills/**/usage.json
skills/**/*-memory.md

# Screenshots (dev testing artifacts)
test-*.png
verify-*.png
topology-*.png
final-*.png

# Machine-generated launchers + log files (contain personal paths)
boot.vbs
*.log


# Loose screenshots in repo root (transient)
/*.png

# Loose scratch JS / one-off check snippets
/vd_check.js

# Playwright snapshot dumps
rating-snapshot.yml

# Claude Code worktrees (local working copies, machine-specific)
.claude/worktrees/

# Personal persona definitions for the dogfood-agent app. The app code +
# the generic `new-user.md` persona ship; user-specific personas (with
# real names, employers, life context) stay local. Drop additional .md
# files into apps/dogfood-agent/personas/ — they'll be picked up by the
# loader without being tracked.
apps/dogfood-agent/personas/kevin-weekday.md

# Local scratch dir for dogfood runs, one-off drivers, transcripts
/tmp/
/.tmp/
/.tmp-*.json

# Stale root-level duplicates of emptyos/ — accidental scratch
/__init__.py
/__main__.py
/capabilities/
/cli/
/kernel/
/runtime/
/sdk/
/web/

# Personal one-shot scripts (contain personal data — career, finances)
scripts/ask_openai_*.py

# Scratch — screenshots, ad-hoc JSON, manual test artifacts
_scratch/
scratch/

# Private one-off scripts (underscore prefix)
scripts/_*.py
# ...except shared helpers that committed scripts import (not one-offs)
!scripts/_eos_browser.py

# Serena MCP server cache (server removed 2026-05-14; ignore stragglers if uvx re-spawns it)
.serena/

# CodeBoarding tool cache + logs (generated by scripts/run_codeboarding.py)
.codeboarding/
emptyos/.codeboarding/

# Stale pytest temp cache (created under a restricted ACL; needs admin to delete)
emptyostmppytest-cache/


# Generated by scripts/make-windows-icon.py at build time
brand/*/icon.ico
brand/*/icon.icns
