# EmptyOS Commons — service configuration. Copy to .env and fill in.

# Persistent store. Required. Pick by URL scheme:
#   sqlite:///data/commons.db            trusted-team default — stdlib, one file, no infra
#   postgresql://user:pw@host:5432/db    public / scale — adds the DB-level RLS backstop
#   memory                               tests / ephemeral only (loses data on restart)
COMMONS_DATABASE_URL=sqlite:///data/commons.db

# Opaque session-token HMAC secret (32+ chars). Required.
COMMONS_SESSION_HASH_SECRET=change-me-to-a-long-random-string-32+

# Exact browser origin; enforced on every mutating request. Required.
# In a TLS deploy this MUST equal https://$COMMONS_DOMAIN.
COMMONS_PUBLIC_ORIGIN=https://commons.example.com

# --- Deploy only (docker-compose + Caddy) ---
# Domain Caddy provisions a Let's Encrypt cert for + reverse-proxies. Point its
# DNS A record at this host. Leave unset for local (non-Docker) runs.
COMMONS_DOMAIN=commons.example.com

# Identity provider:
#   password — simple in-service email+password (trusted-team default)
#   firebase — managed IdP (product-level upgrade path)
#   dev      — insecure local/test only
COMMONS_AUTH_PROVIDER=password

# --- Password mode (COMMONS_AUTH_PROVIDER=password) ---
# If set, /auth/register requires this shared secret (a closed-team invite).
# Leave blank for open registration on a trusted network.
COMMONS_REGISTRATION_SECRET=
COMMONS_MIN_PASSWORD_LEN=8

# --- Firebase (when COMMONS_AUTH_PROVIDER=firebase) — the upgrade path ---
COMMONS_FIREBASE_PROJECT_ID=
COMMONS_FIREBASE_WEB_API_KEY=
COMMONS_FIREBASE_AUTH_DOMAIN=

# --- Dev auth (when COMMONS_AUTH_PROVIDER=dev) — NEVER in production ---
# Bearer token is treated as "subject" or "subject:email".
# COMMONS_DEV_AUTH=1

# Cookie + session
COMMONS_SESSION_SECURE=true
COMMONS_SESSION_TTL_SECONDS=86400

# Signup posture. false (default) = open signup: any verified identity gets a
# commons-only account on first sign-in. true = invite-only (account must be
# pre-created before a login is accepted).
COMMONS_INVITE_ONLY=false

# Branding
COMMONS_PRODUCT_NAME=EmptyOS Commons
COMMONS_PRODUCT_TAGLINE=A shared knowledge space — public, private, and shared on purpose.
