# EmptyOS Configuration Template
# Copy to emptyos.toml and edit for your machine.
#
# EmptyOS is built on human capabilities: think, read, write, search.
# Without any tools configured, it asks YOU to fulfill these.
# Add providers to automate what you want automated.

[os]
name = "My EmptyOS"
# home = "/hub/"  # Override with an app route or Space, e.g. /workspaces/#engineering
data_dir = "./data"
log_level = "INFO"

[notes]
# Path to your markdown vault (Obsidian, Logseq, or any folder)
path = "/path/to/your/vault"
watch = true

[network]
host = "0.0.0.0"          # 0.0.0.0 = accessible from network, 127.0.0.1 = local only
port = 9000

# ═══════════════════════════════════════════════════════
# CAPABILITIES — what the OS can do
# ═══════════════════════════════════════════════════════
# Each capability tries providers in order. "human" is always the final fallback.
# Only configure what you want to automate.

[capabilities.think]
providers = ["ollama"]     # try these in order; human is always last
timeout = 30               # seconds per provider before fallback

# --- Provider: Ollama (local LLM) ---
[capabilities.think.ollama]
host = "http://localhost:11434"
model = "llama3.1"

# --- Provider: OpenAI (cloud LLM) ---
# [capabilities.think.openai]
# host = "https://api.openai.com"   # or any OpenAI-compatible endpoint
# model = "gpt-5-mini"
# api_key_env = "OPENAI_API_KEY"    # reads from environment variable

# --- Provider: Claude CLI (requires Claude Code Max subscription) ---
# [capabilities.think.claude]
# max_tokens = 4096

# --- Provider: LM Studio (local, OpenAI-compatible) ---
# [capabilities.think.lmstudio]
# host = "http://localhost:1234"
# model = "default"

# --- Domain routing (optional) ---
# Different models for different task types:
# [capabilities.think.domains.code]
# providers = ["openai"]
# model = "gpt-5"
#
# [capabilities.think.domains.reason]
# providers = ["claude"]

[scheduler]
enabled = true
timezone = "UTC"            # or "Australia/Sydney", "America/New_York", etc.

[retention]
# Set any value to 0 to disable that retention sweep.
events_days = 30             # persisted event-bus history
syslog_rows = 20000          # most recent structured log rows
runs_days = 90               # dated data/apps/*/runs/ directories only

# ═══════════════════════════════════════════════════════
# PLUGINS — connections to external services
# ═══════════════════════════════════════════════════════
# All plugins are optional. If a service isn't reachable,
# the plugin degrades gracefully (no crash, no error).
# Change host/port to match YOUR service locations.
#
# Disable a single plugin: add `enabled = false` under its section, e.g.
#     [plugins.comfyui]
#     enabled = false                    # hard override — wins over Store gate
# This is a repo-trackable disable. For day-to-day on/off use /store instead.
# For permanent retirement across every machine, list the id in
# plugins/BLACKLIST.toml (no `force_load` escape).

[plugins]
path = "./plugins"

# --- Ollama (local LLM inference) ---
[plugins.ollama]
host = "http://localhost:11434"       # change port if needed
model = "llama3.1"                    # default model for generate

# --- Search providers ---
# Default search chain is grep-on-the-vault → human. The "code" domain
# (opt-in via `self.search("query", domain="code")`) uses semble for
# hybrid semantic + BM25 code search over the EmptyOS repo, falling back
# to grep when semble isn't installed (`pip install semble`). Index lives
# in memory; rebuild via the provider's reindex() service method.
# Vault semantic search embeddings (used by the /search app's mode=embed +
# BaseApp.embed_text/embedding_index). DARK BY DEFAULT: with no [embeddings]
# table, it uses OpenAI text-embedding-3-small (cloud) — unchanged behaviour.
#
# For a LOCAL, private, offline embedder, point it at ollama (which already
# serves an OpenAI-compatible /v1/embeddings endpoint). Pull the model first:
#   ollama pull bge-m3         # 1024-dim, strong 中英 multilingual (recommended)
#   ollama pull nomic-embed-text   # 768-dim, lighter/faster, English-leaning
# Then:
# [embeddings]
# provider = "ollama"          # "openai" (default) | "ollama"
# model = "bge-m3"             # dim auto-derived; set `dim` for an unlisted model
# base_url = "http://127.0.0.1:11434/v1"
#
# Notes:
# - Switching models re-embeds once (caches are per-model, never mixed).
# - No cross-model query-time fallback: when the local server is down, search
#   degrades to grep/keyword (correct + private), NOT to a cloud embedder.
#   Keep provider="openai" as an opt-in alternative primary for no-GPU boxes.

[capabilities.search]
# (no config knobs for the default/code chains — wired in setup.py)

# The "files" domain (opt-in via `self.search("budget*.xlsx", domain="files")`)
# does instant filename/path discovery via each OS's native file index:
#   Windows → Everything (es.exe)       — install voidtools CLI tools
#   macOS   → mdfind (Spotlight)        — built in, no install
#   Linux   → fd                        — `apt install fd-find` (fd/fdfind)
# Dark by default — enable below; only the matching OS backend is registered.
# Filename/path only (content searches fall through to grep). Results are scoped
# to allowed_roots at both the query and post-filter level, so a whole-machine
# index never leaks filenames outside your vault/repo; with no roots it refuses
# to search. We never use Everything's HTTP server (it exposes every indexed
# file for download by default) — local CLI/IPC only.
# [capabilities.search.files]
# enabled = true
# allowed_roots = ["notes", "repo"]        # tokens (notes/vault, repo) or paths; default [vault, repo]
# es_path = "C:/Tools/Everything/es.exe"   # Windows: es.exe location (optional — else PATH)
# fd_path = "/usr/bin/fdfind"              # Linux: fd/fdfind location (optional — else PATH)
# # macOS mdfind is always at /usr/bin/mdfind — no path key needed.

# --- Headroom (REMOVED 2026-05-26) ---
# Context-compression middleware deleted from disk and blacklisted in
# plugins/BLACKLIST.toml after wedging the daemon three times in three
# days (no wall-clock timeout, no passthrough fallback). Do not add a
# [plugins.headroom] block; the blacklist will refuse to load it anyway.

# --- ComfyUI (GPU image/video generation) ---
# [plugins.comfyui]
# host = "http://localhost:8188"      # or remote: http://gpu-server:8188
# launcher = ""                       # path to ComfyUI launch script (auto-start)

# --- Voice API (TTS + STT) ---
# [plugins.voice-api]
# host = "http://localhost:8601"      # F5-TTS + Whisper service

# --- Applio (AI voice conversion) ---
# [plugins.applio]
# host = "http://localhost:6969"

# --- Blender (3D rendering) ---
# [plugins.blender]
# host = "http://localhost:8400"      # Blender addon server
# executable = ""                     # auto-detected per platform
# output_dir = "./data/blender-output"

# --- Telegram Bot (two-way notifications) ---
# [plugins.telegram]
# bot_token = "YOUR_BOT_TOKEN"       # from @BotFather
# chat_id = "YOUR_CHAT_ID"           # your Telegram user ID

# --- Health watchdog ---
# [plugins.health]
# watchdog_interval = 60              # seconds between health checks
# ollama_host = ""                    # auto-reads from plugins.ollama.host
# comfyui_host = ""                   # auto-reads from plugins.comfyui.host

# ═══════════════════════════════════════════════════════
# APPS
# ═══════════════════════════════════════════════════════

[apps]
path = "./apps"
autostart = []              # app IDs to start on boot (empty = start all)

# Per-app AI settings (runtime, no restart needed):
#   eos settings set think.app.shadowing "ollama"
#   eos settings set think.app.shadowing.providers "ollama,openai"
#   eos settings set think.app.shadowing.timeout 60

# ── Store app: marketplace registry ──
# The Store's Marketplace tab browses an "official registry" — a list of
# installable community apps. Default (when unset/empty) is the in-repo
# registry/index.json that ships with this clone. Point registry_url at a
# remote raw JSON to track a live registry, or at your own fork's index.
#
# [apps.store]
# registry_url = "https://raw.githubusercontent.com/<owner>/<repo>/main/registry/index.json"

# ── Publish app: site chatbot integration ──
# The publish app proxies admin calls to the standalone chatbot service
# (services/chatbot/). Set these only if you run that service.
#
# [apps.publish.chatbot]
# endpoint    = "https://chat.binbian.net"   # default endpoint when a site
#                                            # doesn't override it in its
#                                            # site profile (sites.json)
# admin_token = ""                           # MUST match CHATBOT_ADMIN_TOKEN
#                                            # set on the chat service host;
#                                            # without it, Q&A admin endpoints
#                                            # are disabled in the UI

# ═══════════════════════════════════════════════════════
# GPU SERVICES (legacy format, prefer plugins.* above)
# ═══════════════════════════════════════════════════════

# [services.gpu]
# comfyui = ""
# tts = ""
